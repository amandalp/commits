# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Used for the seed script and privileged writes. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Public base URL (used for auth redirects + share links).
# Local dev: http://localhost:3000 — Production: your Vercel URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the scheduled deadline-nudge cron (Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`). Set the same value in Vercel env.
# If unset, /api/cron/deadline-nudges is unauthenticated (dev only).
CRON_SECRET=your-long-random-string
